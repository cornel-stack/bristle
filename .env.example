# Bristle environment variables.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local` or any file with real secrets.

# Postgres connection — Supabase Transaction pooler (port 6543), used for RUNTIME queries.
# postgres-js connects with { prepare: false } because the pooler does not support prepared statements.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Postgres connection — direct/session mode (port 5432), used ONLY by db:migrate / drizzle-kit.
# The migrator needs advisory locks + prepared statements the pooler lacks.
DATABASE_URL_DIRECT="postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase project URL — documented for forward compatibility; NOT consumed by application code this slice.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase publishable key (new key format, prefix "sb" + "_publishable_"); documented for
# forward compatibility; NOT consumed by application code this slice.
SUPABASE_PUBLISHABLE_KEY="<your-supabase-publishable-key>"
