# apps/pipeline environment. The real .env is gitignored. Dev → the dev Supabase
# project (wired in Batch C); prod is held by Railway's secret store (Batch D).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Inngest (Batch D — Inngest Cloud serve model). No Algolia key: the HN endpoint
# (hn.algolia.com/api/v1) is public/keyless.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Tunables — Decision 4 / OD-1. B (lookback) wider than Algolia's indexing lag.
LOOKBACK_HOURS=24
BACKFILL_HOURS=72
ALGOLIA_BASE=https://hn.algolia.com/api/v1

# === Slice 5.2 (filter classifier + embedder) ===
# Model-provider keys — gated (Railway vars for prod; gitignored .env for dev).
# Per-slice ML deps under the standing OD-7 principle. No real spend in CI (mocked).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost guard (5.2 Decision 5). Per-run item cap + a daily $ ceiling (a runaway
# tripwire WELL above steady-state — $20, NOT $5 which sits near real daily cost);
# on breach the run halts GRACEFULLY (process up to the cap, log, exit — no crash).
MAX_ITEMS_PER_RUN=1000
DAILY_USD_CEILING=20

# Classifier + embedder (5.2 Decisions 2/3). FORCED_KEEP_BELOW is a STARTING
# default, calibrated against the gold eval set in Batch D (5.2-OD-3/OD-6).
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small
PROMPT_VERSION=v1
FORCED_KEEP_BELOW=0.5
CLASSIFY_BODY_TOKENS=500
EMBED_BODY_TOKENS=1000

# Tests use an EPHEMERAL pgvector/pgvector:pg16 container, never a real Supabase
# (Batch B is gate-free; 0006 needs pgvector).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/pipeline_test
