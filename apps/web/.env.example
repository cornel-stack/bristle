# Bristle environment variables — example values
#
# Copy this file to apps/web/.env.local and fill in the values for local
# development. In production, set these in the Vercel project settings.

# ─── Resend — contact form delivery (slice 008) ──────────────────────────────
#
# All three vars below are required for the contact form to actually send.
# If any is missing or empty at request time, sendContactMessage gracefully
# degrades to { ok: false, reason: "not-configured" } and the form renders
# its inline error banner ("Could not send right now. Email us directly at
# support@bristle.dev and we'll respond from there.") without throwing.
# This lets the slice ship and merge before bristle.dev is DNS-verified in
# Resend — the form goes live the moment env vars land in Vercel.

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form submissions. Must be a real address you
# check. Example: hello@bristle.dev
CONTACT_FORM_RECIPIENT=

# Sender identity for the email (format: 'Display Name <address@verified.dom>').
# The domain in the address MUST be verified in Resend (SPF + DKIM records).
# Example: Bristle Contact <contact@bristle.dev>
CONTACT_FORM_FROM=

# ─── Auth.js v5 — production authentication (slice 013) ──────────────────────

# Session/cookie encryption secret. REQUIRED — apps/web/src/auth.ts throws at
# module load if unset. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Sender identity for auth transactional email (verify / reset / welcome),
# sent via the same Resend key above. Format 'Display Name <address@verified.dom>';
# domain MUST be verified in Resend. Separate from CONTACT_FORM_FROM by design.
# Example: Bristle <noreply@bristle.dev>
EMAIL_FROM=

# ─── OAuth providers — Google + GitHub (slice 014) ───────────────────────────
#
# REQUIRED once OAuth ships — apps/web/src/auth.ts throws at module load if any
# is unset (same fail-loud shape as AUTH_SECRET). These MUST also be listed in
# turbo.json's build.env array, or the Vercel build dies at "Collecting page
# data" even when the values are set in Vercel (the slice-013 AUTH_SECRET trap).
#
# Google: Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Canonical origin Auth.js v5 uses to build OAuth callback + redirect URLs.
# `trustHost: true` (auth.ts) lets it infer from the request, but pinning AUTH_URL
# is the recommended belt-and-suspenders for OAuth on Vercel serverless. Set per
# environment (do NOT commit a real value):
#   local       AUTH_URL=http://localhost:3000
#   production   AUTH_URL=https://<prod-domain>
#   branch prev  AUTH_URL=https://bristle-git-<branch>-<team>.vercel.app
AUTH_URL=
